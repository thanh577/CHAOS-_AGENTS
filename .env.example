# CHAOS environment template — PLACEHOLDERS ONLY, never real secrets.
# Copy to .env for local use. .env is git-ignored.

# Cloud AI provider (set when Milestone 1 starts; unused in M0)
# CHAOS_AI_PROVIDER=
# CHAOS_AI_MODEL=
# CHAOS_AI_API_KEY=
# CHAOS_AI_ENDPOINT=

# Runtime
# CHAOS_ENV=development
# CHAOS_DATA_DIR=./data
# CHAOS_LOG_LEVEL=INFO
