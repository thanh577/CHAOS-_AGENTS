# CHAOS environment template — PLACEHOLDERS ONLY, never real secrets.
# Copy to .env for local use. .env is git-ignored and NEVER read by the app
# (configuration loads from the process environment only).
# Names must match ChaosSettings.from_env in src/chaos/cau_hinh/settings.py.

# Application: development | testing | production (default: development)
# CHAOS_ENV=development
# CHAOS_DEBUG=false

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
# CHAOS_LOG_LEVEL=INFO

# Runtime bounds (seconds, 0 < timeout <= 600; default: 60)
# CHAOS_REQUEST_TIMEOUT=60

# Storage location (no database in M0; default: ./data)
# CHAOS_DATA_DIR=./data

# Security (default: true)
# CHAOS_MASK_SECRETS=true

# Cloud AI placeholders (optional unless CHAOS_ENV=production; unused before M1)
# CHAOS_AI_PROVIDER=
# CHAOS_AI_MODEL=
# CHAOS_AI_API_KEY=
# CHAOS_AI_ENDPOINT=
